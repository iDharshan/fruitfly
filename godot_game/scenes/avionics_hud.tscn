[node name="HelpTitle" type="Label" parent="RootControl/HelpPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.95, 0.85, 1.0)
theme_override_font_sizes/font_size = 16
text = "DROSOPHILA 3D: NEURO-FLIGHT CONTROLS"
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="RootControl/HelpPanel/VBox"]
layout_mode = 2

[node name="HelpText" type="RichTextLabel" parent="RootControl/HelpPanel/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.85, 0.92, 0.98, 1.0)
theme_override_font_sizes/normal_font_size = 13
bbcode_enabled = true
text = "[color=#00f5d4][b]FLIGHT & NAVIGATION:[/b][/color]
• [b]W / S[/b]: Forward Throttle Up / Down (0% - 100%)
• [b]A / D[/b]: Steering Yaw (Injects torque into biological P-EN shifters)
• [b]Space / Shift[/b]: Climb / Dive Vertical Lift
• [b]Q / E[/b]: Lateral Banking Roll
• [b]M[/b]: Toggle [b]MANUAL[/b] vs [b]AUTO PFL3[/b] (Cast-and-Surge Anemotaxis)
• [b]T[/b]: Toggle Celestial Sun Beacon Tracking (Phototaxis / Menotaxis)
• [b]R[/b]: Reset Flight & CANN Attractor State

[color=#00f5d4][b]CAMERA & CONNECTOME INSPECTION:[/b][/color]
• [b]C[/b] or [b]TAB[/b]: Cycle 4 Camera Modes (Chase -> FPV -> Orbit -> Split)
• [b]1, 2, 3, 4[/b]: Direct Camera Select (Chase / FPV / Orbit / Split)
• [b]Right-Click Drag[/b]: Free 360° Orbit Inspection around fly
• [b]Left-Click Drag on Brain[/b]: Interactive 3D Connectome Orbit
• [b]Scroll Wheel on Brain[/b]: Zoom In / Out on Connectome
• [b]F11[/b]: Toggle Borderless Fullscreen
• [b]H / F1[/b]: Toggle This Help Guide"

[node name="BtnCloseHelp" type="Button" parent="RootControl/HelpPanel/VBox"]
layout_mode = 2
text = "CLOSE (H)"

